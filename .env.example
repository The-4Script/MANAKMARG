# MANAK MARG configuration. Copy to .env (never commit .env) or set these as platform environment variables.
# Every value is optional; the defaults below run the demo.

# --- Server ---
# Bind address and port. Containers and PaaS platforms need HOST=0.0.0.0; most platforms inject PORT.
HOST=127.0.0.1
PORT=8000
# Comma-separated browser origins allowed to call the API. Only needed when the frontend is hosted on a
# different origin than the API (the default build serves the frontend from the API itself).
MANAKMARG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MANAKMARG_LOG_LEVEL=INFO

# --- Data ---
# SQLite database (relative paths are resolved from the repository root).
MANAKMARG_DB_PATH=data/processed/manakmarg.sqlite3
# Runtime data bundle used by `python -m manakmarg start` / `import-data` when the database is missing.
# Leave empty to use deploy/data/manakmarg-data.tar.gz from the repository; set to an https:// URL to download it.
MANAKMARG_DATA_URL=
# Repository root override, only needed if the backend package is installed outside the repository.
MANAKMARG_HOME=

# --- Document gap analysis uploads (temporary, deleted after the TTL) ---
MANAKMARG_UPLOAD_TTL_MINUTES=120
MANAKMARG_UPLOAD_MAX_MB=15

# --- Ingestion (only for rebuilding data from official sources) ---
MANAKMARG_FETCH_MIN_DELAY_S=2.5
MANAKMARG_OFFLINE=false

# --- Optional LLM (not required; the demo uses deterministic EN/HI templates) ---
ANTHROPIC_API_KEY=
MANAKMARG_LLM_MODEL=

# --- Optional Groq (voice transcription + routing hints for questions no local rule can route) ---
# Server-side secret: set it in the host's secret store, never in frontend code or git. Without it, every
# deterministic feature works and the voice button is disabled.
GROQ_API_KEY=
# MANAKMARG_GROQ_REASONING_MODEL=openai/gpt-oss-120b
# MANAKMARG_GROQ_FAST_MODEL=openai/gpt-oss-20b
# MANAKMARG_GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# MANAKMARG_GROQ_TRANSCRIPTION_FALLBACK_MODEL=whisper-large-v3
# MANAKMARG_GROQ_TIMEOUT_S=8
# MANAKMARG_GROQ_TRANSCRIPTION_TIMEOUT_S=30
# Voice uploads: maximum recording size and requests per client per minute.
MANAKMARG_VOICE_MAX_MB=10
MANAKMARG_VOICE_REQUESTS_PER_MINUTE=12

# --- Frontend build (only when hosting the frontend separately; read by Vite at build time) ---
# VITE_API_BASE_URL=https://your-api.example.com
